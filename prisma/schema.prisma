generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id           Int     @id @default(autoincrement())
  student_code String? @unique
  name         String
  class        String
  medium       String
  parent_name  String?
  photo_url    String?
  roll_no      String?
  email        String? @unique
  password     String?
  auth_user_id String? @unique @db.Uuid

  // Additive fields & relations
  class_id      Int?
  class_rel     SchoolClass? @relation(fields: [class_id], references: [id])
  medium_id     Int?
  medium_rel    Medium?      @relation(fields: [medium_id], references: [id])
  is_active     Boolean      @default(true)
  academic_year String       @default("2025-2026")

  marks                 Marks[]
  attendance            Attendance[]
  certificate_requests  CertificateRequest[]
  alumni_tracking       AlumniTracking?

  @@map("students")
}

model Teacher {
  id          Int      @id @default(autoincrement())
  staff_id    String?  @unique
  email       String?  @unique
  phone       String?
  password    String?
  auth_user_id String? @unique @db.Uuid
  name        String
  subject     String
  medium      String
  category    String?
  designation String?
  experience  String?
  joined_date DateTime @default(now())
  photo_url   String?

  // Additive fields & relations
  is_active        Boolean          @default(true)
  academic_year    String           @default("2025-2026")
  subject_teachers SubjectTeacher[]

  @@map("teachers")
}

model Gallery {
  id          Int       @id @default(autoincrement())
  image_url   String?
  category    String?
  description String?
  upload_date DateTime? @default(now()) @db.Timestamp(6)

  @@map("gallery")
}

model Notice {
  id          Int       @id @default(autoincrement())
  title       String?
  description String?
  date        DateTime? @db.Timestamp(6)

  @@map("notices")
}

model Alumni {
  id           Int       @id @default(autoincrement())
  student_code String?
  name         String?
  email        String?
  phone        String?
  batch_year   String?
  profession   String?
  photo_url    String?
  status       String?   @default("Pending") // Pending, Approved, Rejected
  applied_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("alumni")
}

model Attendance {
  id           Int       @id @default(autoincrement())
  student_code String?
  class        String?
  teacher_name String?
  date         DateTime? @db.Timestamp(6)
  status       String?
  medium       String?
  section      String?   @default("A")

  // Additive fields & relations
  period         String?
  subject        String?
  attendance_day String?
  student_id     Int?
  student        Student? @relation(fields: [student_id], references: [id])
  subject_id     Int?
  subject_rel    Subject? @relation(fields: [subject_id], references: [id])
  is_active      Boolean  @default(true)
  academic_year  String   @default("2025-2026")

  @@unique([student_id, subject_id, attendance_day, period])
  @@map("attendance")
}

model Marks {
  id           Int     @id @default(autoincrement())
  student_code String?
  class        String?
  subject      String?
  exam_type    String?
  marks        Int?
  medium       String?
  section      String? @default("A")
  total        Int?

  // Additive fields & relations
  student_id    Int?
  student       Student? @relation(fields: [student_id], references: [id])
  exam_id       Int?
  exam          Exam?    @relation(fields: [exam_id], references: [id])
  subject_id    Int?
  subject_rel   Subject? @relation(fields: [subject_id], references: [id])
  is_active     Boolean  @default(true)
  academic_year String   @default("2025-2026")

  @@unique([student_id, subject_id, exam_id])
  @@map("marks")
}

model CertificateRequest {
  id               Int       @id @default(autoincrement())
  student_code     String?
  certificate_type String?
  status           String?   @default("Pending")
  request_date     DateTime? @default(now()) @db.Timestamp(6)

  // Additive fields & relations
  student_id    Int?
  student       Student? @relation(fields: [student_id], references: [id])
  is_active     Boolean  @default(true)
  academic_year String   @default("2025-2026")

  @@map("certificate_requests")
}

model ClassSubject {
  id      Int    @id @default(autoincrement())
  class   String
  subject String

  @@unique([class, subject])
  @@map("class_subjects")
}

// ==================== RELATIONAL MODELS ====================

model Medium {
  id        Int      @id @default(autoincrement())
  name      String   @unique // e.g. "CBSE", "Kannada", "English"
  is_active Boolean  @default(true)
  
  students  Student[]
  classes   SchoolClass[]
  subjects  Subject[]
  
  @@map("mediums")
}

model SchoolClass {
  id        Int      @id @default(autoincrement())
  name      String   // e.g. "1", "2", ..., "10"
  medium_id Int
  medium    Medium   @relation(fields: [medium_id], references: [id])
  is_active Boolean  @default(true)
  
  students  Student[]
  subjects  Subject[]
  
  @@unique([name, medium_id])
  @@map("school_classes")
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String   // e.g. "Mathematics", "Science"
  class_id    Int
  class       SchoolClass @relation(fields: [class_id], references: [id])
  medium_id   Int
  medium      Medium   @relation(fields: [medium_id], references: [id])
  is_active   Boolean  @default(true)
  
  subject_teachers SubjectTeacher[]
  marks            Marks[]
  attendance       Attendance[]

  @@unique([name, class_id, medium_id])
  @@map("subjects")
}

model SubjectTeacher {
  id         Int      @id @default(autoincrement())
  subject_id Int
  subject    Subject  @relation(fields: [subject_id], references: [id])
  teacher_id Int
  teacher    Teacher  @relation(fields: [teacher_id], references: [id])
  is_active  Boolean  @default(true)
  
  @@unique([subject_id, teacher_id])
  @@map("subject_teachers")
}

model Exam {
  id            Int      @id @default(autoincrement())
  name          String   @unique // e.g. "Midterm", "Final"
  academic_year String   @default("2025-2026")
  is_active     Boolean  @default(true)
  
  marks         Marks[]
  
  @@map("exams")
}

model AlumniTracking {
  id                   Int             @id @default(autoincrement())
  student_id           Int             @unique
  student_rel          Student         @relation(fields: [student_id], references: [id])
  graduation_batch     String          // E.g., "2026"
  higher_education     String?         // E.g., "B.Tech Computer Science"
  employment_status    String?         // E.g., "Employed", "Student", "Unemployed"
  current_organization String?         // E.g., "Google", "MIT"
  email                String?
  phone                String?
  created_at           DateTime        @default(now()) @db.Timestamp(6)

  @@map("alumni_tracking")
}

model GraduatedStudent {
  id              Int      @id @default(autoincrement())
  student_code    String?
  name            String
  graduation_year String
  medium          String
  email           String?
  phone           String?
  created_at      DateTime @default(now()) @db.Timestamp(6)

  @@map("graduated_students")
}
