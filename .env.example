# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5000
ADMIN_PASSWORD=your_secure_admin_password_here

# School Email & Nodemailer SMTP Configuration
SCHOOL_EMAIL=schoolemail@example.com
SCHOOL_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
SCHOOL_NAME=SBS Karkala

# Neon PostgreSQL Database Configuration
DATABASE_URL="postgresql://neondb_owner:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-example.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-example.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Branch & Auth Configuration
NEON_BRANCH=production
NEON_BRANCH_ID=br-example
NEON_FUNCTION_HOST_SUFFIX=.compute.region.aws.neon.tech
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://ep-example.rt.region.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_secret_key_here
NEON_SESSION_COOKIE_SECRET=64_character_hex_secret_here
